# Required
VULNS_ADMIN_PASSWORD=replace-with-a-long-password

# One-click updates: shared secret between VulnS and its updater sidecar.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty to disable the Update button (the app then only checks and informs).
VULNS_UPDATER_TOKEN=

# Pin the running release (the tag the updater moved to); latest by default.
# VULNS_VERSION=0.2.0

# Optional, defaults shown
VULNS_ADMIN_USERNAME=admin
VULNS_PORT=8000
VULNS_MAX_UPLOAD_MB=50
# Set to true when VulnS is served over HTTPS
VULNS_SECURE_COOKIES=false
# Set to true to accept a password shorter than 8 characters
VULNS_ALLOW_WEAK_PASSWORD=false
# Generated on first start and kept in the data volume when empty
VULNS_SESSION_SECRET=
# Enables the MCP endpoint for AI agents; at least 32 characters
VULNS_AGENT_TOKEN=
# Set to false to never check GitHub for a newer release
VULNS_UPDATE_CHECK=true
# Override where release.json is fetched from (defaults to the GitHub release)
# VULNS_RELEASE_MANIFEST_URL=http://my-manifest-host/release.json
